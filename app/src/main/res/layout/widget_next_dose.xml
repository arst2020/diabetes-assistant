<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B9F0F2" android:textSize="12sp" android:text="@string/widget_next" />
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="2"
        android:ellipsize="end" android:text="@string/widget_none" />
    <TextView android:id="@+id/w_progress" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E0F7F7" android:textSize="13sp" />
</LinearLayout>
